{
  "name": "inkdabba-expense-mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/utils/settlements.test.ts src/utils/formatters.test.ts src/constants/theme.test.ts",
    "doctor": "npx expo-doctor",
    "export:web": "npx expo export --platform web",
    "eas:init": "npx eas-cli init",
    "build:android": "npx eas-cli build --platform android --profile production",
    "build:preview": "npx eas-cli build --platform android --profile preview",
    "build:ios": "npx eas-cli build --platform ios --profile production",
    "build:production": "npx eas-cli build --platform all --profile production",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy:hosting": "npm run export:web && npx firebase-tools deploy --only hosting",
    "deploy:firebase": "npm run export:web && npx firebase-tools deploy --only firestore:rules,hosting"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "@tanstack/react-query": "^5.64.2",
    "expo": "~57.0.26",
    "expo-asset": "~57.0.18",
    "expo-camera": "~57.0.6",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-manipulator": "~57.0.20",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-local-authentication": "~57.0.3",
    "expo-print": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.22",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-updates": "~57.0.24",
    "firebase": "^12.15.0",
    "lucide-react-native": "^1.14.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/react": "~19.2.18",
    "babel-preset-expo": "~57.0.13",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@xmldom/xmldom": "0.9.10",
    "postcss": "8.5.12",
    "tar": "7.5.13",
    "uuid": "14.0.0"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  },
  "private": true
}
